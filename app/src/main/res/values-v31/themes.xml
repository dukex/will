<resources>
    <!--
      Android 12+ shows a system splash screen between cold-start and the
      activity window. By default it picks up the launcher icon and the
      window background. Force it to true black so the splash matches
      Will's home surface and never flashes a lighter intermediate frame.
    -->
    <style name="Theme.Will" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/will_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/will_background</item>
    </style>
</resources>
